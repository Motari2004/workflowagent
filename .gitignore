execution_logs/
memory/
workflows/*.json
!workflows/.gitkeep

# ─── Generated media ───────────────────────────────
*.png
*.jpg
*.jpeg
*.wav
*.mp3
apod_*.png
image_*.png
voice_*.wav

# ─── Python ────────────────────────────────────────
__pycache__/
*.pyc
venv/
.venv/

